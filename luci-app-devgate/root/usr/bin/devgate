#!/bin/bash

crrun=$1
crid=$2
NAME=devgate
DEBUG=1  # 开启调试

config_t_get() {
	local index=${3:-0}
	local ret=$(uci -q get "${NAME}.@${1}[${index}].${2}")
	echo "${ret:-$4}"
}

LOG_FILE="/var/log/devgate.log"
IDLIST="/var/$NAME.idlist"

bin_nft=$(which nft 2>/dev/null)
bin_iptables=$(which iptables 2>/dev/null)
bin_ip6tables=$(which ip6tables 2>/dev/null)
bin_conntrack=$(which conntrack 2>/dev/null)

get_device_chain() {
	local id="$1"
	local device_chain=$(config_t_get device chain "$id" "forward")

	case "$device_chain" in
		input)
			echo "input"
			;;
		*)
			echo "forward"
			;;
	esac
}

dbg() {
	if [ "$DEBUG" -eq 1 ]; then
		local d="$(date '+%Y-%m-%d %H:%M:%S')"
		echo "[$d] FW-DEBUG: $@" >> "$LOG_FILE"
		echo "FW-DEBUG: $@"
	fi
}

info() {
	local d="$(date '+%Y-%m-%d %H:%M:%S')"
	echo "[$d] FW-INFO: $@" >> "$LOG_FILE"
	echo "FW-INFO: $@"
}

# 地址解析函数 - 修复格式问题
parse_target() {
	local target="$1"

	# 去除空格
	target=$(echo "${target}" | xargs)

	dbg "解析目标地址: $target"

	# IPv4单个地址
	if echo "$target" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
		local octets=(${target//./ })
		local valid=1
		for octet in "${octets[@]}"; do
			if [ "$octet" -gt 255 ] || [ "$octet" -lt 0 ]; then
				valid=0
				break
			fi
		done
		[ "$valid" -eq 1 ] && {
			echo "ipv4:single:$target"
			return 0
		}

	# IPv4范围
	elif echo "$target" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}-([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
		local start_ip=${target%-*}
		local end_ip=${target#*-}
		echo "ipv4:range:$start_ip-$end_ip"
		return 0

	# CIDR
	elif echo "$target" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$'; then
		local ip=${target%/*}
		local mask=${target#*/}
		[ "$mask" -le 32 ] && [ "$mask" -ge 0 ] && {
			echo "ipv4:cidr:$target"
			return 0
		}

	# MAC地址
	elif echo "$target" | grep -qE '^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$'; then
		echo "mac:single:$(echo "$target" | tr '[:upper:]' '[:lower:]')"
		return 0

	# IPv6地址
	elif echo "$target" | grep -qE '^([0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}$'; then
		echo "ipv6:single:$target"
		return 0

	# IPv6 CIDR
	elif echo "$target" | grep -qE '^([0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}/[0-9]{1,3}$'; then
		local ipv6=${target%/*}
		local mask=${target#*/}
		[ "$mask" -le 128 ] && [ "$mask" -ge 0 ] && {
			echo "ipv6:cidr:$target"
			return 0
		}
	fi

	dbg "无法解析地址: $target"
	return 1
}

# 清理现有连接
flush_connections() {
	local target="$1"

	[ -x "$bin_conntrack" ] || {
		dbg "conntrack不可用"
		return
	}

	local parsed_result=$(parse_target "$target")
	[ $? -eq 0 ] || {
		dbg "无法解析地址用于清理连接: $target"
		return
	}

	IFS=':' read -r type subtype value <<< "$parsed_result"

	dbg "清理连接: type=$type, value=$value"

	case "$type" in
		"ipv4")
			$bin_conntrack -D -s "$value" 2>/dev/null && dbg "清理源连接: $value"
			$bin_conntrack -D -d "$value" 2>/dev/null && dbg "清理目标连接: $value"
			;;
		"mac")
			# MAC地址需要先转换为IP
			if [ -f "/proc/net/arp" ]; then
				local ip_addr=$(grep -i "$value" /proc/net/arp 2>/dev/null | awk '{print $1}' | head -1)
				if [ -n "$ip_addr" ]; then
					$bin_conntrack -D -s "$ip_addr" 2>/dev/null && dbg "清理MAC源连接: $value -> $ip_addr"
					$bin_conntrack -D -d "$ip_addr" 2>/dev/null && dbg "清理MAC目标连接: $value -> $ip_addr"
				fi
			fi
			;;
	esac
}

# 检查防火墙工具
check_firewall_tool() {
	nftables_ver=
	iptables_ver=

	if [ -x "$bin_nft" ]; then
		nftables_ver=1
		dbg "检测到nftables: $bin_nft"
	elif [ -x "$bin_iptables" ] && [ -x "$bin_ip6tables" ]; then
		iptables_ver=1
		dbg "检测到iptables: $bin_iptables, $bin_ip6tables"
	else
		info "错误: 未找到可用的防火墙工具"
		return 1
	fi
	return 0
}

# 初始化防火墙
init_firewall() {
	check_firewall_tool || return 1

	info "初始化防火墙规则 (黑名单模式，控制强度按设备规则)"

	if [ -n "$nftables_ver" ]; then
		# 使用nftables
		dbg "初始化nftables"

		# 删除可能存在的旧表
		nft delete table inet devgate 2>/dev/null
		sleep 1

		# 创建新表
		nft add table inet devgate
		nft add chain inet devgate forward "{ type filter hook forward priority -100; policy accept; }"

		# 创建黑名单集合
		nft add set inet devgate blacklist "{ type ipv4_addr; flags interval; }"
		nft add set inet devgate blacklist6 "{ type ipv6_addr; flags interval; }"
		nft add set inet devgate blacklist_mac "{ type ether_addr; }"
		nft add set inet devgate blacklist_input "{ type ipv4_addr; flags interval; }"
		nft add set inet devgate blacklist6_input "{ type ipv6_addr; flags interval; }"
		nft add set inet devgate blacklist_mac_input "{ type ether_addr; }"

		# 禁止访问公共网络：匹配到就DROP转发流量
		nft add rule inet devgate forward ip saddr @blacklist drop
		nft add rule inet devgate forward ip6 saddr @blacklist6 drop
		nft add rule inet devgate forward ether saddr @blacklist_mac drop

		# 禁止访问全部网络：额外匹配访问路由器本机的INPUT流量
		nft add chain inet devgate input "{ type filter hook input priority -100; policy accept; }"
		nft add rule inet devgate input ip saddr @blacklist_input drop
		nft add rule inet devgate input ip6 saddr @blacklist6_input drop
		nft add rule inet devgate input ether saddr @blacklist_mac_input drop

		info "nftables初始化完成"

	elif [ -n "$iptables_ver" ]; then
		# 使用iptables
		dbg "初始化iptables"

		# 创建ipset（如果不存在）
		ipset create devgate_blacklist hash:net 2>/dev/null || {
			ipset flush devgate_blacklist
			dbg "已存在的ipset devgate_blacklist已清空"
		}

		ipset create devgate_blacklist6 hash:net family inet6 2>/dev/null || {
			ipset flush devgate_blacklist6
			dbg "已存在的ipset devgate_blacklist6已清空"
		}

		ipset create devgate_input_blacklist hash:net 2>/dev/null || {
			ipset flush devgate_input_blacklist
			dbg "已存在的ipset devgate_input_blacklist已清空"
		}

		ipset create devgate_input_blacklist6 hash:net family inet6 2>/dev/null || {
			ipset flush devgate_input_blacklist6
			dbg "已存在的ipset devgate_input_blacklist6已清空"
		}

		# 删除可能存在的旧规则
		iptables -D FORWARD -m set --match-set devgate_blacklist src -j DROP 2>/dev/null
		ip6tables -D FORWARD -m set --match-set devgate_blacklist6 src -j DROP 2>/dev/null
		iptables -D INPUT -m set --match-set devgate_input_blacklist src -j DROP 2>/dev/null
		ip6tables -D INPUT -m set --match-set devgate_input_blacklist6 src -j DROP 2>/dev/null

		# 禁止访问公共网络
		iptables -I FORWARD -m set --match-set devgate_blacklist src -j DROP
		ip6tables -I FORWARD -m set --match-set devgate_blacklist6 src -j DROP

		dbg "已添加FORWARD规则"

		# 禁止访问全部网络
		iptables -I INPUT -m set --match-set devgate_input_blacklist src -j DROP
		ip6tables -I INPUT -m set --match-set devgate_input_blacklist6 src -j DROP

		dbg "已添加INPUT规则"

		info "iptables初始化完成"
	fi

	return 0
}

# 停止防火墙规则
stop_firewall() {
	info "停止防火墙规则"
	check_firewall_tool || return 1

	if [ -n "$nftables_ver" ]; then
		nft delete table inet devgate 2>/dev/null && info "nftables规则已删除"
	fi

	if [ -n "$iptables_ver" ]; then
		# 删除iptables规则
		iptables -D FORWARD -m set --match-set devgate_blacklist src -j DROP 2>/dev/null
		iptables -D INPUT -m set --match-set devgate_blacklist src -j DROP 2>/dev/null
		ip6tables -D FORWARD -m set --match-set devgate_blacklist6 src -j DROP 2>/dev/null
		ip6tables -D INPUT -m set --match-set devgate_blacklist6 src -j DROP 2>/dev/null
		iptables -D INPUT -m set --match-set devgate_input_blacklist src -j DROP 2>/dev/null
		ip6tables -D INPUT -m set --match-set devgate_input_blacklist6 src -j DROP 2>/dev/null

		# 删除ipset
		ipset destroy devgate_blacklist 2>/dev/null
		ipset destroy devgate_blacklist6 2>/dev/null
		ipset destroy devgate_input_blacklist 2>/dev/null
		ipset destroy devgate_input_blacklist6 2>/dev/null

		info "iptables规则已删除"
	fi

	# 清理ID列表
	rm -f "$IDLIST"
}

# 添加设备到防火墙
add_device() {
	check_firewall_tool || return 1

	local id="$1"
	local target=$(config_t_get device mac "$id")
	local device_chain=$(get_device_chain "$id")
	[ -z "$target" ] && {
		dbg "添加设备失败: ID $id 的目标地址为空"
		return
	}

	local comment=$(config_t_get device comment "$id" "设备$id")
	info "添加设备到防火墙: $comment ($target, $device_chain)"

	local parsed_result=$(parse_target "$target")
	if [ $? -ne 0 ]; then
		info "添加失败: 无法解析地址 $target"
		return
	fi

	IFS=':' read -r type subtype value <<< "$parsed_result"
	dbg "解析结果: type=$type, subtype=$subtype, value=$value"

	if [ -n "$nftables_ver" ]; then
		# nftables处理
		case "$type" in
			"ipv4")
				nft add element inet devgate blacklist "{ $value }" 2>&1 | while read line; do dbg "nft: $line"; done
				[ "$device_chain" = "input" ] && nft add element inet devgate blacklist_input "{ $value }" 2>&1 | while read line; do dbg "nft: $line"; done
				dbg "已添加到nftables黑名单(IPv4): $value"
				;;
			"ipv6")
				nft add element inet devgate blacklist6 "{ $value }" 2>&1 | while read line; do dbg "nft: $line"; done
				[ "$device_chain" = "input" ] && nft add element inet devgate blacklist6_input "{ $value }" 2>&1 | while read line; do dbg "nft: $line"; done
				dbg "已添加到nftables黑名单(IPv6): $value"
				;;
			"mac")
				nft add element inet devgate blacklist_mac "{ $value }" 2>&1 | while read line; do dbg "nft: $line"; done
				[ "$device_chain" = "input" ] && nft add element inet devgate blacklist_mac_input "{ $value }" 2>&1 | while read line; do dbg "nft: $line"; done
				dbg "已添加到nftables黑名单(MAC): $value"
				;;
		esac

	elif [ -n "$iptables_ver" ]; then
		# iptables处理
		case "$type" in
			"ipv4")
				ipset add devgate_blacklist "$value" 2>&1 | while read line; do dbg "ipset: $line"; done
				[ "$device_chain" = "input" ] && ipset add devgate_input_blacklist "$value" 2>&1 | while read line; do dbg "ipset: $line"; done
				dbg "已添加到ipset黑名单(IPv4): $value"
				;;
			"ipv6")
				ipset add devgate_blacklist6 "$value" 2>&1 | while read line; do dbg "ipset: $line"; done
				[ "$device_chain" = "input" ] && ipset add devgate_input_blacklist6 "$value" 2>&1 | while read line; do dbg "ipset: $line"; done
				dbg "已添加到ipset黑名单(IPv6): $value"
				;;
			"mac")
				# iptables不支持MAC地址直接过滤，记录日志
				info "警告: iptables不支持MAC地址过滤，设备 $target 可能无法被阻止"
				;;
		esac
	fi

	# 禁止访问全部网络时清理现有连接，让规则立即生效
	if [ "$device_chain" = "input" ]; then
		dbg "禁止访问全部网络，清理现有连接"
		flush_connections "$target"
	fi

	# 验证规则
	verify_firewall_rule "$target"
}

# 验证防火墙规则
verify_firewall_rule() {
	local target="$1"

	dbg "验证防火墙规则: $target"

	if [ -n "$nftables_ver" ]; then
		nft list table inet devgate 2>/dev/null | grep -q "$target" && {
			dbg "验证成功: $target 在nftables规则中"
			return 0
		}
	elif [ -n "$iptables_ver" ]; then
		ipset test devgate_blacklist "$target" 2>/dev/null && {
			dbg "验证成功: $target 在ipset中"
			return 0
		}
	fi

	dbg "验证失败: $target 不在防火墙规则中"
	return 1
}

# 从防火墙移除设备
del_device() {
	check_firewall_tool || return 1

	local id="$1"
	local target=$(config_t_get device mac "$id")
	local device_chain=$(get_device_chain "$id")
	[ -z "$target" ] && {
		dbg "移除设备失败: ID $id 的目标地址为空"
		return
	}

	local comment=$(config_t_get device comment "$id" "设备$id")
	info "从防火墙移除设备: $comment ($target, $device_chain)"

	local parsed_result=$(parse_target "$target")
	[ $? -eq 0 ] || {
		info "移除失败: 无法解析地址 $target"
		return
	}

	IFS=':' read -r type subtype value <<< "$parsed_result"

	if [ -n "$nftables_ver" ]; then
		case "$type" in
			"ipv4")
				nft delete element inet devgate blacklist "{ $value }" 2>/dev/null
				nft delete element inet devgate blacklist_input "{ $value }" 2>/dev/null
				dbg "已从nftables移除(IPv4): $value"
				;;
			"ipv6")
				nft delete element inet devgate blacklist6 "{ $value }" 2>/dev/null
				nft delete element inet devgate blacklist6_input "{ $value }" 2>/dev/null
				dbg "已从nftables移除(IPv6): $value"
				;;
			"mac")
				nft delete element inet devgate blacklist_mac "{ $value }" 2>/dev/null
				nft delete element inet devgate blacklist_mac_input "{ $value }" 2>/dev/null
				dbg "已从nftables移除(MAC): $value"
				;;
		esac

	elif [ -n "$iptables_ver" ]; then
		case "$type" in
			"ipv4")
				ipset del devgate_blacklist "$value" 2>/dev/null
				ipset del devgate_input_blacklist "$value" 2>/dev/null
				dbg "已从ipset移除(IPv4): $value"
				;;
			"ipv6")
				ipset del devgate_blacklist6 "$value" 2>/dev/null
				ipset del devgate_input_blacklist6 "$value" 2>/dev/null
				dbg "已从ipset移除(IPv6): $value"
				;;
		esac
	fi
}

# 显示防火墙状态
show_firewall_status() {
	check_firewall_tool || return 1

	echo ""
	echo "防火墙状态:"
	echo "控制方式: 黑名单"
	echo "控制强度: 按设备规则"
	echo ""

	if [ -n "$nftables_ver" ]; then
		echo "nftables规则:"
		nft list table inet devgate 2>/dev/null || echo "  未找到devgate表"
	elif [ -n "$iptables_ver" ]; then
		echo "iptables规则:"
		echo "FORWARD链:"
		iptables -L FORWARD -n | grep -i devgate || echo "  未找到devgate规则"
		ip6tables -L FORWARD -n | grep -i devgate || echo "  未找到IPv6 devgate规则"

		echo ""
		echo "INPUT链:"
		iptables -L INPUT -n | grep -i devgate || echo "  未找到devgate规则"
		ip6tables -L INPUT -n | grep -i devgate || echo "  未找到IPv6 devgate规则"

		echo ""
		echo "ipset内容:"
		ipset list devgate_blacklist 2>/dev/null | head -20 || echo "  devgate_blacklist未找到"
		echo ""
		ipset list devgate_blacklist6 2>/dev/null | head -20 || echo "  devgate_blacklist6未找到"
	fi
}

# 诊断函数
diagnose() {
	echo ""
	echo "=== 设备门禁系统诊断 ==="
	echo ""

	# 检查服务
	echo "1. 服务状态:"
	if pidof devgatectrl >/dev/null 2>&1; then
		echo "   ✓ devgatectrl 正在运行"
	else
		echo "   ✗ devgatectrl 未运行"
	fi

	# 检查配置文件
	echo ""
	echo "2. 配置文件:"
	if [ -f "/etc/config/devgate" ]; then
		echo "   ✓ 配置文件存在"
		uci show devgate 2>/dev/null | grep -c "device" | while read count; do
			echo "   配置了 $count 个设备"
		done
	else
		echo "   ✗ 配置文件不存在"
	fi

	# 检查防火墙工具
	echo ""
	echo "3. 防火墙工具:"
	if [ -x "$bin_nft" ]; then
		echo "   ✓ nftables: $bin_nft"
		echo "   版本: $($bin_nft --version 2>/dev/null | head -1)"
	elif [ -x "$bin_iptables" ]; then
		echo "   ✓ iptables: $bin_iptables"
		echo "   版本: $($bin_iptables --version 2>/dev/null | head -1)"
	else
		echo "   ✗ 未找到防火墙工具"
	fi

	# 显示当前规则
	show_firewall_status

	# 检查ID列表
	echo ""
	echo "4. 当前控制列表:"
	if [ -f "$IDLIST" ] && [ -s "$IDLIST" ]; then
		echo "   当前禁止的设备:"
		cat "$IDLIST" | sed 's/!//g' | while read id; do
			local target=$(config_t_get device mac "$id")
			local comment=$(config_t_get device comment "$id" "设备$id")
			echo "   ID$id: $comment ($target)"
		done
	else
		echo "   当前没有设备被禁止"
	fi

	echo ""
	echo "=== 诊断完成 ==="
}

# 主命令处理
case "$crrun" in
	"start")
		info "启动设备门禁"
		stop_firewall
		init_firewall
		if [ $? -eq 0 ]; then
			info "设备门禁启动成功"
			show_firewall_status
		else
			info "设备门禁启动失败"
		fi
		;;

	"stop")
		info "停止设备门禁"
		stop_firewall
		info "设备门禁已停止"
		;;

	"add")
		[ -z "$crid" ] && {
			echo "错误: 需要指定设备ID"
			exit 1
		}
		info "添加设备控制: ID=$crid"
		add_device "$crid"
		show_firewall_status
		;;

	"del")
		[ -z "$crid" ] && {
			echo "错误: 需要指定设备ID"
			exit 1
		}
		info "移除设备控制: ID=$crid"
		del_device "$crid"
		show_firewall_status
		;;

	"status")
		show_firewall_status
		;;

	"diagnose")
		diagnose
		;;

	"test")
		# 测试地址解析
		echo "测试地址解析:"
		for test in "192.168.1.100" "192.168.1.0/24" "00:11:22:33:44:55" "invalid"; do
			echo -n "$test: "
			if parse_target "$test" >/dev/null; then
				echo "✓ 有效"
				parse_target "$test"
			else
				echo "✗ 无效"
			fi
		done
		;;

	"flush")
		# 清理所有连接
		info "清理所有连接"
		if [ -x "$bin_conntrack" ]; then
			$bin_conntrack -F
			info "连接已清理"
		else
			info "conntrack不可用"
		fi
		;;

	"help"|"")
		echo "设备门禁系统命令工具"
		echo ""
		echo "用法: $0 {start|stop|add <id>|del <id>|status|diagnose|test|flush|help}"
		echo ""
		echo "命令说明:"
		echo "  start           - 初始化防火墙规则"
		echo "  stop            - 停止并清理所有防火墙规则"
		echo "  add <id>        - 添加设备到控制列表"
		echo "  del <id>        - 从控制列表移除设备"
		echo "  status          - 显示防火墙状态"
		echo "  diagnose        - 系统诊断"
		echo "  test            - 测试地址解析"
		echo "  flush           - 清理所有网络连接"
		echo "  help            - 显示此帮助信息"
		;;

	*)
		echo "错误: 未知命令 '$crrun'"
		echo "使用: $0 help 查看帮助"
		exit 1
		;;
esac
